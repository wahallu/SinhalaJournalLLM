{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-app-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "apps/web-app"
      ],
      "port": 5173
    },
    {
      "name": "web-app-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "apps/web-app/dist",
        "-l",
        "4173"
      ],
      "port": 4173
    }
  ]
}

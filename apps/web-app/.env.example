# Copy to .env and fill in real values. .env is gitignored.
#
# Supabase Settings → API. Both values are safe in a browser bundle: the anon
# key grants nothing on its own, because every table is guarded by Row Level
# Security. Never put the service_role key here — it bypasses RLS entirely.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). Safe in a browser bundle — this identifies the app to
# Google, it does not authenticate anything by itself. Must match
# GOOGLE_CLIENT_ID in apps/backend-api/.env. Leave empty to hide the
# Sign in with Google button.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

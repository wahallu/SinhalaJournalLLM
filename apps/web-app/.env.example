# Copy to .env and fill in real values. .env is gitignored.
#
# Supabase Settings → API. Both values are safe in a browser bundle: the anon
# key grants nothing on its own, because every table is guarded by Row Level
# Security. Never put the service_role key here — it bypasses RLS entirely.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

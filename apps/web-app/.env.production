# Build-time config for production images.
#
# Committed on purpose. Vite inlines these at build time, so they end up
# in the JS bundle every visitor downloads either way — the anon key is
# designed for that and is constrained by Row Level Security. The
# service-role key is the dangerous one and lives only in the backend's
# .env, which stays untracked.
#
# Docker --build-arg still overrides these when set (see Dockerfile), so
# a different environment can point elsewhere without editing this file.

VITE_SUPABASE_URL=https://lcokluvpqyhkaslkdzpb.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imxjb2tsdXZwcXloa2FzbGtkenBiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI5MDEyMjgsImV4cCI6MjA5ODQ3NzIyOH0.MIZsitdG_6uw4f5-imZdrSDWXPMBTmlfH3XorvWus3o

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). Safe in a browser bundle — this identifies the app to
# Google, it does not authenticate anything by itself. Must match
# GOOGLE_CLIENT_ID in apps/backend-api/.env. Leave empty to hide the
# Sign in with Google button.
VITE_GOOGLE_CLIENT_ID=842434243630-97ui4d8e93bn3ut6csgnk9986fqrl2n9.apps.googleusercontent.com
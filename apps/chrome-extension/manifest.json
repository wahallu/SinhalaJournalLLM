{
  "manifest_version": 3,
  "name": "SinAI — SinhalaJournal LLM Assistant",
  "version": "1.1.0",
  "description": "Real-time Sinhala grammar checking, headlines generation, rewriting, and summarization directly in your browser.",
  "key": "",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "clipboardWrite",
    "identity"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://sinhalajournalllm.onrender.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_end"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon128.png",
        "fonts/Gwen-Trial-Regular.woff2",
        "fonts/Gwen-Trial-Bold.woff2"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}

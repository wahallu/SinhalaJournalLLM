# Copy to .env and fill in real values. .env is gitignored.

# ── Supabase ──
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server-only secret — bypasses RLS. Never expose to client apps.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
postgresql://postgres:[YOUR-PASSWORD]@db.lcokluvpqyhkaslkdzpb.supabase.co:5432/postgres
# ── App ──
APP_ENV=development

# ── Model gateway ──
# Primary inference provider: sinllama | openrouter | mock
#   sinllama   → the fine-tuned SinLlama inference server (research GPU box)
#   openrouter → hosted LLM stand-in while the GPU server is offline
#   mock       → deterministic offline output (no network needed)
MODEL_PROVIDER=sinllama
# Fall through sinllama → openrouter → mock when a provider fails
MODEL_FALLBACK=true

# SinLlama inference server (SinAI-Training/work/sinllama/serve_sinai.py)
#   uvicorn work.sinllama.serve_sinai:app --host 0.0.0.0 --port 8000
SINLLAMA_API_URL=http://localhost:8000
# SinLlama comparison server (now merged into serve_sinai.py on port 8000)
SINLLAMA_COMPARISON_API_URL=http://localhost:8000
SINLLAMA_TIMEOUT_SECONDS=120

# Hybrid grammar-validation defaults. The admin Settings page can override
# these at runtime without changing the model or redeploying.
GRAMMAR_RULE_VALIDATION_ENABLED=true
GRAMMAR_AUTO_SAFE_ORTHOGRAPHY=true
GRAMMAR_PROTECT_ENTITIES=true
GRAMMAR_PROTECT_NUMBERS=true
GRAMMAR_PROTECT_QUOTES=true
GRAMMAR_AGREEMENT_VALIDATION=true
GRAMMAR_CONTEXTUAL_RULES=true

# OpenRouter fallback (leave key empty to disable this provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Groq — used exclusively for visual prompt generation
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# GPT Image 2 generation (server-side; never expose this key to Vite/browser vars)
OPENAI_API_KEY=

# Permanent generated-image storage. Copy the CLOUDINARY_URL value from the
# Cloudinary dashboard. Without it images still generate, but cannot reopen
# from History after the page is closed.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ── CORS (comma-separated origins) ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Auth (self-hosted; Supabase Auth is no longer used) ──
# Signing key for this app's own access/refresh tokens. No default: an empty
# value makes the backend refuse to issue or verify anything.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_TOKEN_TTL_MINUTES=60

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). Not secret. Must match VITE_GOOGLE_CLIENT_ID in
# apps/web-app/.env. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=

# ── Outbound email (Gmail SMTP) ──
# Gmail needs an App Password — 16 characters, and the account must have
# 2-Step Verification switched on first. A normal account password will not
# authenticate. Free Gmail sends roughly 500 messages a day.
# Leave SMTP_HOST empty in development: links are logged instead of mailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=SinAi <your-address@gmail.com>
# Used to build the links inside those emails.
APP_BASE_URL=http://localhost:5173
# Any long random string. Changing it resets anonymous rate-limit buckets.
IP_HASH_SALT=

# Anonymous (logged-out) tool requests allowed per hour per IP.
ANON_REQUESTS_PER_HOUR=20

# Proxies in front of this app that append to X-Forwarded-For. Only the last
# N entries are trustworthy. Render's load balancer is one hop; add more only
# if you put a CDN in front, and never guess high — too many lets callers
# spoof their IP and evade the anonymous rate limit.
TRUSTED_PROXY_COUNT=1

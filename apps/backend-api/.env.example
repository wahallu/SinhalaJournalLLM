# Copy to .env and fill in real values. Never commit the actual .env.

# ── Supabase (self-hosted via Coolify) ──
# From the Supabase service's own page in Coolify. PUBLIC_SUPABASE_URL is
# the Kong API gateway (routes to PostgREST/Auth/Storage) — backend-api
# talks to Postgres through it, not via a direct DATABASE_URL connection.
PUBLIC_SUPABASE_URL=http://<kong-host>/
# Service role key bypasses Row Level Security entirely — this is a
# server-only secret. Never send it to web-app, chrome-extension, or any
# other client; those would use PUBLIC_SUPABASE_ANON_KEY instead, if they
# ever talk to Supabase directly (they currently don't — only backend-api does).
SUPABASE_SERVICE_ROLE_KEY=<service-role-jwt>

# ── App ──
APP_ENV=development

# ── CORS (comma-separated origins) ──
CORS_ORIGINS=http://localhost:5173

# Copy to .env and fill in real values. .env is gitignored.

# ── Supabase ──
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server-only secret — bypasses RLS. Never expose to client apps.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ──
APP_ENV=development

# ── Model gateway ──
# Primary inference provider: sinllama | openrouter | mock
#   sinllama   → the fine-tuned SinLlama inference server (research GPU box)
#   openrouter → hosted LLM stand-in while the GPU server is offline
#   mock       → deterministic offline output (no network needed)
MODEL_PROVIDER=sinllama
# Fall through sinllama → openrouter → mock when a provider fails
MODEL_FALLBACK=true

# SinLlama inference server (SinAI-Training/work/sinllama/serve_sinai.py)
#   uvicorn work.sinllama.serve_sinai:app --host 0.0.0.0 --port 8001
SINLLAMA_API_URL=http://localhost:8001
SINLLAMA_TIMEOUT_SECONDS=120

# OpenRouter fallback (leave key empty to disable this provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ── CORS (comma-separated origins) ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Copy to .env and fill in real values. .env is gitignored.

# ── Supabase ──
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server-only secret — bypasses RLS. Never expose to client apps.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ──
APP_ENV=development

# ── Model gateway ──
# Primary inference provider: sinllama | openrouter | mock
#   sinllama   → the fine-tuned SinLlama inference server (research GPU box)
#   openrouter → hosted LLM stand-in while the GPU server is offline
#   mock       → deterministic offline output (no network needed)
MODEL_PROVIDER=sinllama
# Fall through sinllama → openrouter → mock when a provider fails
MODEL_FALLBACK=true

# SinLlama inference server (SinAI-Training/work/sinllama/serve_sinai.py)
#   uvicorn work.sinllama.serve_sinai:app --host 0.0.0.0 --port 8000
SINLLAMA_API_URL=http://localhost:8000
# SinLlama comparison server (now merged into serve_sinai.py on port 8000)
SINLLAMA_COMPARISON_API_URL=http://localhost:8000
SINLLAMA_TIMEOUT_SECONDS=120

# OpenRouter fallback (leave key empty to disable this provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Groq — used exclusively for visual prompt generation
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── CORS (comma-separated origins) ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Auth ──
# Supabase Settings → API → JWT Settings → JWT Secret (HS256 projects)
SUPABASE_JWT_SECRET=
# Asymmetric projects instead expose a JWKS endpoint:
#   https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Supabase Settings → API → Project API keys → anon / public
SUPABASE_ANON_KEY=
# Any long random string. Changing it resets anonymous rate-limit buckets.
IP_HASH_SALT=

# Anonymous (logged-out) tool requests allowed per hour per IP.
ANON_REQUESTS_PER_HOUR=20

# Proxies in front of this app that append to X-Forwarded-For. Only the last
# N entries are trustworthy. Render's load balancer is one hop; add more only
# if you put a CDN in front, and never guess high — too many lets callers
# spoof their IP and evade the anonymous rate limit.
TRUSTED_PROXY_COUNT=1
